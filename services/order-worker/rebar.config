{erl_opts, [debug_info]}.
{deps, [{amqp_client, "~> 3.12"}, {jsx, "3.1.0"}]}.
{relx, [
  {release, {order_worker, "0.1.0"}, [order_worker, sasl]},
  {dev_mode, true},
  {include_erts, false},
  {extended_start_script, true}
]}.
{profiles, [{prod, [{relx, [{dev_mode, false}, {include_erts, true}]}]}]}.
